# Copy to .env and fill in. Never commit the real .env.

# Postgres connection string (docker-compose exposes 5433 locally)
DATABASE_URL=postgres://bookleaf:bookleaf@localhost:5433/bookleaf

# Long random string used to sign session cookies. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# AI provider: any OpenAI-compatible Chat Completions endpoint.
# Default: a free local model through Ollama (https://ollama.com), no key needed:
#   brew install ollama && ollama serve      (or install the Ollama app)
#   ollama pull llama3.2
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3.2
AI_API_KEY=

# Or use a hosted provider with your own key, by swapping the three lines above:
# Google Gemini (free tier, key at https://aistudio.google.com/apikey)
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_MODEL=gemini-flash-lite-latest
# Groq (free tier, key at https://console.groq.com/keys)
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=openai/gpt-oss-120b
# Anthropic Claude (paid, key at https://console.anthropic.com)
#   AI_BASE_URL=https://api.anthropic.com/v1/
#   AI_MODEL=claude-haiku-5-5
# OpenAI (paid)
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
#
# No local model running and no key? The app still works: tickets show as "Unclassified"
# and admins write replies themselves.

# Optional overrides
# PORT=4000
# NODE_ENV=development
