# Copy to .env and fill in. Never commit the real .env.

# Postgres connection string (docker-compose exposes 5433 locally)
DATABASE_URL=postgres://bookleaf:bookleaf@localhost:5433/bookleaf

# Long random string used to sign session cookies. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# AI provider: any OpenAI-compatible Chat Completions endpoint.
# Default is Google Gemini's free tier. Get a key (no card needed) at https://aistudio.google.com/apikey
# Leave AI_API_KEY empty to run with AI disabled (the app still works; tickets show as "Unclassified").
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-flash-lite-latest
# Groq instead (free tier, https://console.groq.com/keys):
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b

# Optional overrides
# PORT=4000
# NODE_ENV=development
